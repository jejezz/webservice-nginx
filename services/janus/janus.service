# Janus WebRTC 게이트웨이 — services/janus/install.sh 가 설치합니다.
# 직접 고치지 마세요. 고칠 곳은 services/janus/janus.service 입니다.
#
# Janus 는 배포판 패키지가 아니라 /opt/janus 소스 빌드이고, 유닛이 딸려 오지
# 않습니다. 그래서 이 저장소가 소유합니다 (pm2-conf/app.ini 참고 — pm2 는
# 이 서비스를 관리하지 않습니다).

[Unit]
Description=Janus WebRTC Server (webservices)
Documentation=https://janus.conf.meetecho.com/docs/
Documentation=file:///opt/janus/share/janus/html/docs/index.html
# 인터페이스에 주소가 붙은 뒤에 떠야 합니다. ICE 후보를 기동 시점에 모으므로
# 주소가 없으면 후보 없이 뜹니다.
Wants=network-online.target
After=network-online.target
# Kamailio 는 필수 의존이 아닙니다. 등록은 브라우저가 붙을 때 일어나고, 그때
# Kamailio 가 살아 있으면 됩니다. 다만 순서는 맞춰 둡니다.
After=kamailio.service

[Service]
Type=simple
User=janus
Group=janus

# -o : 색상 이스케이프를 끕니다. 로그는 journald 가 받습니다.
#      (journalctl -u janus)
ExecStart=/opt/janus/bin/janus -o

Restart=on-failure
RestartSec=2

# WebRTC 세션 하나가 소켓을 여럿 씁니다.
LimitNOFILE=65536

# 최소한의 보호. Janus 는 특권 포트를 쓰지 않고(8088·7088·UDP 20000+·30000+)
# 파일을 쓸 일도 없습니다 — 녹화 플러그인을 올리지 않았습니다.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# strict 가 아니라 full 입니다. /opt 를 읽기 전용으로 만들면 나중에 녹화나
# 로그 파일을 켤 때 조용히 막힙니다. /usr·/boot·/etc 보호로 충분합니다.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
