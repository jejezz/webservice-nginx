# Janus WebSocket 트랜스포트 — OWNED-BY-WEBSERVICES (전부 꺼 둠)
#
# derived-from-sample: ec2900b570ec72bd   (janus.transport.websockets.jcfg.sample, Janus 1.4.1)
#
# 이 파일은 services/janus/janus.transport.websockets.jcfg 의 사본입니다.
# **직접 고치지 마세요** — install.sh --apply 가 덮어씁니다.
#
# --- 왜 꺼 두는가 ---
#
# janus.js 는 WebSocket 도 REST 도 모두 지원하므로 어느 쪽이든 동작합니다.
# 그런데 이 프로젝트에서 서비스의 헬스 URL 은
#
#     host + nginx-conf 의 ports[0] + health_path
#
# 로 만들어지고, 서비스 하나에 포트는 하나뿐입니다. 라우트를 WS 포트로 보내면
# 헬스도 그 포트로 가는데, **Janus 의 WS 트랜스포트는 평범한 HTTP GET 에
# 응답하지 않아** manager 대시보드에 영원히 "중단" 으로 뜹니다.
#
# HTTP 트랜스포트로 두면 <base_path>/info 가 그대로 헬스가 되어 규약에 손댈
# 것이 없습니다. 그래서 REST 로 고정하고 이 트랜스포트는 켜지 않습니다.
# 자세한 검토와 나중에 WS 로 옮기는 방법(스키마에 health_port 추가)은
# docs/plan.md 의 ① 절에 있습니다.
#
# 모듈 자체를 janus.jcfg 의 transports.disable 로 막지는 않았습니다. 그러면
# 여기서 ws = true 로 바꿔도 조용히 동작하지 않는 함정이 됩니다. 끄는 자리는
# 이 파일 한 곳입니다.

general: {
	ws = false
	wss = false
}

admin: {
	admin_ws = false
	admin_wss = false
}

cors: {
}

certificates: {
}
