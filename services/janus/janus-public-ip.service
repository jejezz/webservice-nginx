# Janus 기동 직전에 공인 IP 를 설치본에 맞춘다 — services/janus/install.sh 가 설치합니다.
# 직접 고치지 마세요. 고칠 곳은 services/janus/janus-public-ip.service 입니다.
#
# ── 왜 별도 유닛인가 ────────────────────────────────────────────────────
#
# janus.service 의 ExecStartPre 로 넣을 수도 있지만, 그 유닛은 User=janus 로
# 돌고 ProtectHome=true 가 걸려 있습니다. 이 저장소는 /home 아래에 있어서
# 그 안에서는 스크립트에 닿지도 못합니다. 샌드박스를 풀어 주는 대신 유닛을
# 나눴습니다 — 이쪽만 root 로 돌고, Janus 쪽 보호는 그대로 둡니다.
#
# ── 무엇을 하나 ─────────────────────────────────────────────────────────
#
# 가정용 회선은 공인 IP 가 바뀝니다. Janus 는 기동할 때 읽은 값을 ICE 후보로
# 계속 광고하므로, 바뀐 뒤에는 외부 통화가 **신호는 붙고 소리만 안 나는**
# 모양이 됩니다. 고칠 수 있는 자리는 기동 직전뿐입니다.
#
# LAN 전용으로 설치된 장비(nat_1_1_mapping 없음)에서는 아무것도 하지 않습니다.
# 부팅 때 조용히 켜서 밖으로 주소를 광고하기 시작하면 안 됩니다.

[Unit]
Description=Janus 공인 IP 동기화 (기동 직전)
Documentation=file://__REPO_DIR__/README.md
# 이름 해석이 되어야 합니다 — DDNS 이름의 A 레코드를 봅니다.
Wants=network-online.target
After=network-online.target nss-lookup.target
Before=janus.service

[Service]
Type=oneshot
RemainAfterExit=no
# 실패해도 Janus 는 떠야 합니다. 공인 IP 를 못 읽는 것보다 게이트웨이가 아예
# 안 뜨는 편이 나쁩니다 — LAN 통화는 이 값과 무관하게 됩니다.
SuccessExitStatus=0 1 2
ExecStart=__REPO_DIR__/check-public-ip.sh --sync --quiet
# 이름 해석이 늦어도 부팅을 오래 붙들지 않습니다.
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
