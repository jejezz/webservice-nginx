# websocket-relay 환경 변수 예시. 실제 값은 .env 에 두고 커밋하지 않는다.
#
# 비밀값은 이 파일에도 .env 에도 쓰지 않는다 — 파일로 두고 경로만 가리킨다.
#   DB 비밀번호      : database/secrets/jyahn.pw   (database/ 가 소유)
#   Firebase 계정 키 : secrets/firebase-admin.json (600, git 제외)

# nginx 가 443 에서 TLS 를 끊고 이 포트로 평문을 넘긴다.
PORT=28099
# 듣는 주소. 루프백 밖으로 열면 nginx 를 우회한 직접 접근이 생긴다.
BIND_ADDR=127.0.0.1
# 이 서버가 맡은 단지. 32비트를 소문자 16진수 8자로 (생성: openssl rand -hex 4).
# 디렉터리(Firebase)에 올린 값과 같아야 한다. **한 번 정하면 바꾸지 않는다** —
# 바꾸면 이미 등록된 단말이 전부 자기 단지를 잃는다.
# 비워 두면 단지 검사를 하지 않는다 (단지가 하나뿐인 배치).
COMPLEX_ID=

# 착신 푸시에 실어 보낼 Janus 주소. 앱이 이 주소로 붙어 sip 플러그인으로 내선을
# 등록하면, Kamailio 가 붙들어 둔 INVITE 가 그 경로로 전달된다.
# 비우면 payload 에서 생략된다 (앱이 저장해 둔 값을 쓴다).
JANUS_WS_URL=

# 승인된 단말에게 Kamailio 내선 계정을 만들어 준다 (docs/identity.md).
# SIP_DOMAIN 은 kamctlrc 의 SIP_DOMAIN 과 같아야 한다 — 다르면 등록되지 않는다.
# Kamailio 가 없는 개발기에서는 SIP_PROVISION=false 로 두면 승인만 된다.
# 단말마다 다른 Janus 토큰. Janus 쪽 token_auth 를 먼저 켜야 합니다.
JANUS_TOKEN_AUTH=false

SIP_PROVISION=true
SIP_DOMAIN=pluto.org
# 앱이 REGISTER 를 보낼 이 단지의 Kamailio 주소 (예: sip:10.10.0.224:5060).
# 비워 두면 Kamailio settings.ini(또는 이 장비의 LAN IP)에서 자동으로 찾는다
# (npm run setup 이 물어본다). 그마저 못 찾으면 등록 응답에 싣지 않고, 앱은
# 빌드 시점 기본값을 쓴다. 감지가 틀렸을 때만 여기(또는 대시보드)에서 고친다.
SIP_PROXY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jyahn
DB_NAME=rtc_relay
DB_PASSWORD_FILE=../../database/secrets/jyahn.pw
MOBILE_TABLE_NAME=rtc_mobiles
HOMENET_TABLE_NAME=rtc_homenet
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-admin.json
# 단지 디렉터리를 둔 Firestore 데이터베이스 (tools/directory.js 가 쓴다).
# 비워 두면 `(default)`. 프로젝트의 기본 DB 가 Datastore 모드로 만들어져 있으면
# 그 DB 는 쓸 수 없으므로, Native 모드로 따로 만들고 그 이름을 여기 적는다.
FIRESTORE_DATABASE_ID=
LOG_LEVEL=info
CONSOLE_LOGGING=true
WS_PING_INTERVAL=60000
WS_CONNECTION_TIMEOUT=30000
# 방이 비었을 때 등록을 유지하는 시간(ms).
WS_REGISTER_TIMEOUT=1000
ENABLE_CORS=true
CORS_ORIGINS=*
MAX_REQUEST_SIZE=10485760
DEBUG_MODE=false
DEV_MIDDLEWARE=true
TRUST_PROXY=false
# 초인종 호출·등록 알림 (기기 기본 알림음)
FCM_CHANNEL_ID=callfusion_2_rtc_notice
# sip-incoming 착신 (기기 기본 벨소리)
FCM_CALL_CHANNEL_ID=callfusion_2_rtc_call
FCM_PRIORITY=high
FCM_TTL=86400
