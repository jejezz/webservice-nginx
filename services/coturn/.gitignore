# Node 의존성 — server/ 와 web/ 두 곳에 있다
node_modules/
server/node_modules/
web/node_modules/

# 프런트 빌드 산출물
web/dist/

# 배포 설정. 비밀은 아니지만 장비마다 다르다 (공인 IP·realm·포트 범위).
# 대시보드의 '설정' 화면과 사람의 편집기가 쓰고, install.sh --apply 가 읽는다.
# .applied-settings 는 그 결과 기록이다. 항목 정의(settings-schema.json)는 커밋한다.
settings.ini
.applied-settings

# TURN REST API 정적 비밀. install.sh --apply 가 생성해 turnserver.conf 의
# static-auth-secret 으로 넣는다.
secrets/

# 편집기·OS
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp

# 로그
*.log
logs/
