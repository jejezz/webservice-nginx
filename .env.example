# ==============================================
# CallFusion WebRTC Server Environment Configuration - EXAMPLE
# ==============================================
# Copy this file to .env and modify the values according to your setup

# ==============================================
# Server Configuration
# ==============================================
HTTPS_PORT=28090
NODE_ENV=development

# ==============================================
# SSL/TLS Certificate Configuration
# ==============================================
SSL_PRIVATE_KEY_PATH=./src/certs/server.key
SSL_CERTIFICATE_PATH=./src/certs/renewed_server.crt
SSL_CA_PATH=./src/certs/intermediate-ca.crt
SSL_LONGLIVE_PRIVATE_KEY_PATH=./src/certs-longlive/key.pem
SSL_LONGLIVE_CERTIFICATE_PATH=./src/certs-longlive/cert.pem

# ==============================================
# Database Configuration
# ==============================================
SQLITE_DB_PATH=./cf2rtc-sqlite-db.db
MOBILE_TABLE_NAME=rtc_mobiles
HOMENET_TABLE_NAME=rtc_homenet

# ==============================================
# Firebase Configuration
# ==============================================
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-admin.json

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=info
CONSOLE_LOGGING=true

# ==============================================
# WebSocket Configuration
# ==============================================
WS_PING_INTERVAL=60000
WS_CONNECTION_TIMEOUT=30000

# ==============================================
# Security Configuration
# ==============================================
ENABLE_CORS=true
CORS_ORIGINS=*
MAX_REQUEST_SIZE=10485760

# ==============================================
# Development/Debug Configuration
# ==============================================
DEBUG_MODE=false
DEV_MIDDLEWARE=true
TRUST_PROXY=false

# ==============================================
# Firebase Push Notification Configuration
# ==============================================
FCM_CHANNEL_ID=callfusion_2_rtc
FCM_SOUND_FILE=doorbell.wav
FCM_PRIORITY=high
FCM_TTL=86400