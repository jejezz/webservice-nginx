# rtc-relay-server 환경 변수 예시. 실제 값은 .env 에 두고 커밋하지 않는다.
#
# 비밀값은 이 파일에도 .env 에도 쓰지 않는다 — 파일로 두고 경로만 가리킨다.
#   DB 비밀번호      : database/secrets/jyahn.pw   (database/ 가 소유)
#   Firebase 계정 키 : secrets/firebase-admin.json (600, git 제외)

HTTPS_PORT=28099
NODE_ENV=development

# TLS — 프로젝트 인증서를 그대로 쓴다 (nginx/README.md 의 규칙).
# 인증서는 nginx/cert/ 가 소유하고 nginx/nginx-stack.conf [tls] 가 경로를 정한다.
# 이 서비스는 자체 인증서를 두지 않는다. 서비스 디렉토리 기준 상대 경로.
SSL_PRIVATE_KEY_PATH=../../nginx/cert/server/server.key
SSL_CERTIFICATE_PATH=../../nginx/cert/server/server.crt
SSL_CA_PATH=../../nginx/cert/ca/ca.crt
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jyahn
DB_NAME=rtc_relay
DB_PASSWORD_FILE=../../database/secrets/jyahn.pw
MOBILE_TABLE_NAME=rtc_mobiles
HOMENET_TABLE_NAME=rtc_homenet
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-admin.json
LOG_LEVEL=info
CONSOLE_LOGGING=true
WS_PING_INTERVAL=60000
WS_CONNECTION_TIMEOUT=30000
ENABLE_CORS=true
CORS_ORIGINS=*
MAX_REQUEST_SIZE=10485760
DEBUG_MODE=false
DEV_MIDDLEWARE=true
TRUST_PROXY=false
FCM_CHANNEL_ID=callfusion_2_rtc
FCM_SOUND_FILE=doorbell.wav
FCM_PRIORITY=high
FCM_TTL=86400
