# Node 의존성 — 서비스마다 여러 곳에 있다
node_modules/

# 프런트 빌드 산출물
web/dist/
services/*/web/dist/
services/manager/server/public/

# 비밀 — 저장소에 넣지 않는다
#
# ⚠️ nginx/cert/ 는 통째로 뺀다. 서버·CA·클라이언트 개인키가 모두 여기 있다.
#    CA 는 다시 만들면 이미 배포한 클라이언트 인증서가 전부 무효가 되므로,
#    "다시 생성하면 되는 것" 이 아니라 **따로 백업해야 하는 자산**이다.
#    (generate_certs.sh 는 저장소에 있으므로 새 환경에서는 새로 만들 수 있다)
nginx/cert/

database/secrets/
services/*/secrets/
services/*/.env
*.pw
services/manager/config.json
# 관리용 비밀 방 번호. src/ 아래에 만들어진다 (index.ts 의 __dirname 기준).
# services/websocket-relay/.gitignore 도 같은 것을 잡지만, 여기에도 둬서
# 서비스 쪽 파일이 사라져도 새 나가지 않게 한다.
services/websocket-relay/src/.secret-room-id

# Firebase 서비스 계정 키. 위 services/*/secrets/ 규약을 벗어난 자리에 놓인
# 것까지 잡는다 — 예제 디렉토리에 실제 키가 한 벌 들어와 있었다.
# 이 키는 FCM 발송 자격이라 커밋되면 누구나 이 단지 단말에 푸시를 보낼 수 있다.
**/*firebase-adminsdk*.json

# 런타임 산출물
logs/
services/*/logs/
pm2/logs/
*.log
*.pid
database/backups/

# 대시보드에서 바꾼 런타임 설정
services/*/settings.json

# 별도 관리 — 이 저장소가 추적하지 않는다
/services/stock-analyzer/
/services/ws-bridge/

# 이관 중 남은 백업
/.migration-backup/

# 패킷 캡처. 디버깅하다 남는 것들인데, 실제 SIP/SDP 신호가 그대로 들어 있어
# 내선 번호와 단말 주소가 노출된다. 필요하면 저장소 밖에 둔다.
*.pcap
*.pcapng

# Claude Code
#
# settings.local.json 은 개인 설정이다 (.local 규약 — 공유할 설정은
# .claude/settings.json 에 두고 그건 커밋한다).
# worktrees/ 는 작업용으로 만들어진 저장소 사본이라 통째로 중복이다.
#
# **/ 를 붙인다. 슬래시가 든 패턴은 이 파일이 있는 디렉토리(= 저장소 루트)에만
# 걸려서, services/<서비스>/.claude/worktrees/ 는 그냥 통과한다. 실제로 그렇게
# 만들어진 워크트리가 커밋에 딸려 들어간 적이 있다.
**/.claude/settings.local.json
**/.claude/worktrees/

# 작업 중 메모. 저장소에 남길 것은 docs/ 에 둔다.
claude-session-memery.md

# 편집기·OS
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
