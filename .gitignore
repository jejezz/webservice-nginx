# Node 의존성 — 서비스마다 여러 곳에 있다
node_modules/

# 프런트 빌드 산출물
web/dist/
services/*/web/dist/
services/manager/server/public/

# 비밀 — 저장소에 넣지 않는다
#
# ⚠️ nginx/cert/ 는 통째로 뺀다. 서버·CA·클라이언트 개인키가 모두 여기 있다.
#    CA 는 다시 만들면 이미 배포한 클라이언트 인증서가 전부 무효가 되므로,
#    "다시 생성하면 되는 것" 이 아니라 **따로 백업해야 하는 자산**이다.
#    (generate_certs.sh 는 저장소에 있으므로 새 환경에서는 새로 만들 수 있다)
nginx/cert/

database/secrets/
services/*/secrets/
services/*/.env
*.pw
services/manager/config.json
services/rtc-relay-server/.secret-room-id

# 런타임 산출물
logs/
services/*/logs/
pm2/logs/
*.log
*.pid
database/backups/

# 대시보드에서 바꾼 런타임 설정
services/*/settings.json

# 별도 관리 — 이 저장소가 추적하지 않는다
/services/stock-analyzer/
/services/ws-bridge/

# 이관 중 남은 백업
/.migration-backup/

# 편집기·OS
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
