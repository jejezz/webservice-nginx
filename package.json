{
  "name": "rtc-relay-server",
  "version": "1.0.0",
  "description": "RTC relay/signaling server (WebRTC + IoT) with TypeScript",
  "main": "index.js",
  "author": "jejezz",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.1",
    "express": "^4.18.1",
    "firebase-admin": "^13.4.0",
    "mysql2": "^3.14.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^17.0.45",
    "@types/ws": "^8.5.3",
    "eslint": "^8.17.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.6.2",
    "tsx": "^4.19.4",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "pm2 start ../../pm2/ecosystem.config.js --only rtc-relay-server",
    "build": "tsc -p .",
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"tsx\" src/index.ts",
    "stop": "pm2 stop rtc-relay-server; pm2 delete rtc-relay-server",
    "validate-env": "tsx validate-env.ts",
    "prestart": "npm run validate-env"
  },
  "repository": {
    "type": "git",
    "url": "http://callfusion.ptype.co.kr:22480/webrtc/rtc-relay-server.git"
  },
  "keywords": [],
  "type": "commonjs"
}
