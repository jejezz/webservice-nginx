{
  "name": "callfusion2-ts-node",
  "version": "1.0.0",
  "description": "CallFusion2 Node.js server with typescript",
  "main": "index.js",
  "author": "jejezz",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.1",
    "express": "^4.18.1",
    "firebase": "^11.7.1",
    "firebase-admin": "^13.4.0",
    "fs": "0.0.1-security",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/mysql": "^2.15.21",
    "@types/node": "^17.0.45",
    "@types/ws": "^8.5.3",
    "eslint": "^8.17.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "pm2 start ../ecosystem.config.js --only callfusion2rtc",
    "build": "tsc -p .",
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"tsx\" src/index.ts",
    "stop": "pm2 stop callfusion2rtc; pm2 delete callfusion2rtc",
    "validate-env": "tsx validate-env.ts",
    "prestart": "npm run validate-env"
  },
  "repository": {
    "type": "git",
    "url": "http://callfusion.ptype.co.kr:22480/webrtc/callfusion-ts-server.git"
  },
  "keywords": [],
  "type": "commonjs"
}
