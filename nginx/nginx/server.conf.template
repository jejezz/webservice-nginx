# 서버 수준 골격.
#
# 업스트림과 location 블록은 여기에 적지 않는다 —
# generate_nginx_conf.py 가 services/*/nginx-conf/*.ini 를 읽어 채워 넣는다.
# 라우트를 바꾸려면 이 파일이 아니라 각 서비스의 nginx-conf/ 를 고친다.
#
# 스키마: WebServices/docs/nginx-conf.md

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

__UPSTREAMS__

server {
    listen __LISTEN_PORT__ default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen __SSL_PORT__ ssl http2;
    server_name _;

    client_max_body_size __MAX_BODY__;

    ssl_certificate __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_KEY_PATH__;
    ssl_protocols       TLSv1.2 TLSv1.3;

__LOCATIONS__
}
